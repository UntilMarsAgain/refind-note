<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器自适应图标的**背景色**（`mipmap-anydpi-v26/ic_launcher.xml` 引用它）。

  值改成图标底色那个深色：`tauri icon` 默认给 `#FFFFFF`，而我们的图标是
  深色底 + 白图形 —— 白色背景会在图标四周露出一圈白边（系统按形状裁切时尤其明显）。

  ⚠️ 这个文件是 `tauri icon` **自动生成**的：每次重跑图标命令都会被覆盖回
  `#FFFFFF`，所以改完还得再同步 `src-tauri/icons/android/` 与 `gen/android/`。
-->
<resources>
    <color name="ic_launcher_background">#201c1c</color>
</resources>