{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "refind-note",
  "version": "0.1.0",
  "identifier": "com.untilmarsagain.refindnote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "重逢笔记",
        "width": 1200,
        "height": 900,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先的笔记与文件仓库",
    "longDescription": "重逢笔记：笔记、附件、模板与版本都放在一个本地仓库里（~/.refind-note），可选加密、可选 GPG，可通过任意 S3 兼容服务同步。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugin-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "refind"
        ]
      }
    }
  }
}
